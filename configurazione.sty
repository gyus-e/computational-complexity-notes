\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{configurazione}[.Configurazione q, w e u]

\newcommand{\configurazione}[3]{%
    #1
    \begin{pmatrix}
        {#2}_1 \\
        \vdots \\
        {#2}_k
    \end{pmatrix}
    % #1
    \begin{pmatrix}
        {#3}_1 \\
        \vdots \\
        {#3}_k
    \end{pmatrix}%
}

\newcommand{\configurazionestart}[1]{%
    s
    \begin{pmatrix}
        \triangleright \\
        \triangleright \\
        \vdots \\
        \triangleright
    \end{pmatrix}
    % s
    \begin{pmatrix}
        {#1} \\
        \epsilon \\
        \vdots \\
        \epsilon
    \end{pmatrix}%
}

\newcommand{\configurazionepropria}[2]{%
	h
	\begin{pmatrix}
		\triangleright \\
		\triangleright \\
		\vdots \\
		\triangleright \\
		\triangleright
	\end{pmatrix}
	% s
	\begin{pmatrix}
		{#1} \\
		\sqcup^{z_2} \\
		\vdots \\
		\sqcup^{z_{k-1}} \\
		\sqcap^{#2}
	\end{pmatrix}%
}