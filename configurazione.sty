% configurazione.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{configurazione}[.Configurazione q, w e u]

\newcommand{\configurazione}[3]{%
    % #1
    \begin{bmatrix}
        {#2}_1 \\
        \vdots \\
        {#2}_k
    \end{bmatrix}
    #1
    \begin{bmatrix}
        {#3}_1 \\
        \vdots \\
        {#3}_k
    \end{bmatrix}%
}

\newcommand{\configurazionestart}[1]{%
    % s
    \begin{bmatrix}
        \triangleright \\
        \triangleright \\
        \vdots \\
        \triangleright
    \end{bmatrix}
    s
    \begin{bmatrix}
        {#1} \\
        \epsilon \\
        \vdots \\
        \epsilon
    \end{bmatrix}%
}

\newcommand{\configurazionepropria}[2]{%
	% h
	\begin{bmatrix}
		\triangleright \\
		\triangleright \\
		\vdots \\
		\triangleright \\
		\triangleright
	\end{bmatrix}
	h
	\begin{bmatrix}
		{#1} \\
		\sqcup^{z_2} \\
		\vdots \\
		\sqcup^{z_{k-1}} \\
		\sqcap^{#2}
	\end{bmatrix}%
}